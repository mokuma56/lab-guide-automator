# Lab Guide Automator — Environment Configuration
# Copy to .env and fill in values

# ── AI Provider ──────────────────────────────────────────────
# Set to: openai | anthropic | ollama
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-5
ANTHROPIC_VISION_MODEL=claude-opus-4-5

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llava

# TTS for video narration: openai | edge | system
TTS_PROVIDER=openai
# openai tts voice: alloy | echo | fable | onyx | nova | shimmer
TTS_VOICE=nova

# ── MkDocs / Git Push ─────────────────────────────────────────
# Remote git repo for MkDocs site (leave blank to skip push)
MKDOCS_REPO_URL=
MKDOCS_BRANCH=main
MKDOCS_SITE_DIR=site

# ── Storage ───────────────────────────────────────────────────
# Where recordings, sessions, and exports are stored
DATA_DIR=./data
